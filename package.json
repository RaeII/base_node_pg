{
  "name": "base_node",
  "version": "1.0.0",
  "description": "Base Node",
  "main": "dist/index.js",
  "scripts": {
    "build": "NODE_ENV=production tsc && tsc-alias",
    "start": "NODE_ENV=production node dist/index.js",
    "dev": "nodemon",
    "migrate": "node -r ts-node/register scripts/migrate.ts",
    "migrate:status": "node -r ts-node/register scripts/migrate.ts status"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cron": "^3.1.6",
    "dotenv": "^16.5.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "moment": "^2.30.1",
    "pg": "^8.13.1",
    "pg-cursor": "^2.12.1",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.3.5",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.5",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/cron": "^2.4.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/moment-timezone": "^0.5.30",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.11.10",
    "@types/pg-cursor": "^2.7.2",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  }
