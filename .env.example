PORT=

AUTHORIZATION=1
JWT_SECRET=

APP_NAME=base_node_pg

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=
DB_APP_USER=
DB_APP_PASSWORD=

# SSL — em produção, sempre verify-full
DB_SSL=false
DB_SSL_CA=

# Pool tuning (opcional — defaults seguros são aplicados)
DB_POOL_MAX=16
DB_POOL_MIN=2
DB_STATEMENT_TIMEOUT_MS=10000
DB_QUERY_TIMEOUT_MS=12000
DB_LOCK_TIMEOUT_MS=3000
DB_IDLE_TX_TIMEOUT_MS=30000
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=5000
DB_MAX_LIFETIME_SECONDS=1800

# Timezone aplicado via startup packet
DB_TIMEZONE=America/Sao_Paulo

DISCORD_WEBHOOK=
