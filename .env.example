PORT=

# Em produção o boot FALHA se AUTHORIZATION != 1 (fail-closed).
# AUTHORIZATION=0 desliga os middlewares de auth — apenas para dev local.
AUTHORIZATION=1
# Mínimo 32 caracteres (obrigatório em produção). Gere com: openssl rand -base64 48
JWT_SECRET=
# TTL do JWT de usuário em segundos (default 604800 = 7 dias).
# Não há revogação de token — mantenha curto.
JWT_EXPIRES_IN_SECONDS=604800
# TTL do JWT de serviço (POST /auth/create-jwt) — default 2592000 = 30 dias
SERVICE_JWT_EXPIRES_IN_SECONDS=2592000

APP_NAME=base_node_pg

# ─── Segurança HTTP ───
# Origens permitidas no CORS, separadas por vírgula (ex: https://app.exemplo.com,https://admin.exemplo.com).
# Vazio em produção = nenhuma origem cross-site permitida. Em dev, default http://localhost:3000.
CORS_ORIGINS=
# Domain do cookie de auth. Vazio = host-only (recomendado). Ex: .exemplo.com
COOKIE_DOMAIN=
# lax (default, recomendado) | strict | none — "none" exige HTTPS e defesa CSRF própria
COOKIE_SAMESITE=lax
# Nº de proxies confiáveis à frente da app (1 atrás de nginx/traefik).
# Necessário para req.ip correto no rate limit.
TRUST_PROXY=0
# Rate limit global por IP (janela em ms / máx de requisições)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Rate limit do login por IP — conta apenas tentativas FALHAS
RATE_LIMIT_LOGIN_WINDOW_MS=60000
RATE_LIMIT_LOGIN_MAX=5

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=
DB_APP_USER=
DB_APP_PASSWORD=

# Migration user (DDL) — opcional; cai no DB_APP_USER em dev.
# Em produção sempre defina migration_user separado com permissões de DDL.
DB_MIGRATION_USER=
DB_MIGRATION_PASSWORD=

# SSL — em produção, sempre verify-full
DB_SSL=false
DB_SSL_CA=

# Pool write (opcional — defaults seguros são aplicados)
DB_POOL_MAX=16
DB_POOL_MIN=2
DB_STATEMENT_TIMEOUT_MS=10000
DB_QUERY_TIMEOUT_MS=12000
DB_LOCK_TIMEOUT_MS=3000
DB_IDLE_TX_TIMEOUT_MS=15000
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=2000
DB_MAX_LIFETIME_SECONDS=1800

# Pool read / réplica (omitir DB_READ_HOST aponta ao primário — ideal para dev/staging)
# Fórmula: DB_READ_POOL_MAX = (max_connections × 0.8 − reservas) ÷ num_instâncias
DB_READ_HOST=
DB_READ_PORT=
DB_READ_POOL_MAX=
DB_READ_POOL_MIN=1

# Timezone aplicado via startup packet
DB_TIMEZONE=America/Sao_Paulo

DISCORD_WEBHOOK=

# Pool watchdog — alerta no Discord quando waitingCount > 0 / idleCount == 0
POOL_WATCHDOG_INTERVAL_MS=10000
POOL_WATCHDOG_SATURATION_TICKS=3
POOL_WATCHDOG_COOLDOWN_MS=300000
